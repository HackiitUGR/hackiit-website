---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Sobre nosotros — Hackiit',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Nuestra historia"
  >
    <Fragment slot="title">
      Apasionados por el <br />
      <span class="text-accent dark:text-white highlight"> Hacking Ético</span>
    </Fragment>

    <Fragment slot="subtitle">
      Somos un grupo de entusiastas de la ciberseguridad nacidos en la <strong>Escuela Técnica Superior de Ingenierías Informática y de Telecomunicación (ETSIIT)</strong> de la Universidad de Granada. <br/><br/>
      El grupo se fundó en 2016 bajo la dirección del profesor Gabriel Maciá. Hoy en día, Hackiit es un punto de encuentro donde hay sitio para estudiantes, profesores, profesionales y cualquier persona con inquietudes en el sector.
    </Fragment>
  </Hero>

  <Features2
    title="Nuestros objetivos"
    subtitle="Lo que nos mueve y por qué hacemos lo que hacemos"
    items={[
      {
        title: 'Aprender y enseñar',
        description: 'Mejorar continuamente en el arte del hacking ético y ayudar a otros a hacer lo mismo mediante el intercambio de conocimientos.',
        icon: 'tabler:book',
      },
      {
        title: 'Competir y divertirnos',
        description: 'Participar activamente en retos y competiciones CTF (Capture The Flag) para poner a prueba nuestras habilidades en entornos reales.',
        icon: 'tabler:flag',
      },
      {
        title: 'Hacer comunidad',
        description: 'Mantener unida esta pasión y crear lazos que perduren mucho más allá del periodo académico universitario.',
        icon: 'tabler:users',
      },
    ]}
  />

  <Content
    isReversed
    tagline="Únete al club"
    title="¿Qué necesitas para formar parte?"
    items={[
      {
        title: 'Pasión por la ciberseguridad',
        description: 'Tienes que ser un apasionado del hacking y la seguridad informática, ¡exactamente igual que nosotros!',
        icon: 'tabler:heart',
      },
      {
        title: 'Formación y ganas de aprender',
        description: 'Buscamos una base mínima de conocimientos. Pero si aún no la tienes, ¡no te preocupes! Únete a nuestras actividades abiertas, sigue aprendiendo con nosotros y, paso a paso, conviértete oficialmente en uno de los nuestros.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Compromiso y compañerismo',
        description: 'Tienes que estar dispuesto a dedicar tiempo no solo a tu propio aprendizaje, sino a ayudar a otros a crecer en este mundillo.',
        icon: 'tabler:users',
      },
    ]}
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'Grupo de Hackiit',
    }}
  >
    <Fragment slot="content">
      Si cumples estas condiciones y quieres llevar tus habilidades al siguiente nivel, Hackiit es tu lugar. ¡Te estamos esperando!
    </Fragment>
  </Content>
</Layout>