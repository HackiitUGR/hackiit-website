---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

// 1. Importamos el componente Image de Astro
import { Image } from 'astro:assets';

// 2. Importamos las imágenes de los logos locales
// (Asegúrate de tener estos archivos exactos en src/assets/images/)
import ugrLogo from '~/assets/images/ugr-logo.png';
import etsiitLogo from '~/assets/images/etsiit-logo.png';
import jtsecLogo from '~/assets/images/jtsec.png';
import trevenqueLogo from '~/assets/images/trevenque.png';

const metadata = {
  title: 'Hackiit - UGR',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Únete al club',
        href: '/unete',
        icon: 'tabler:rocket',
      },
      { text: 'Leer el blog', href: '#blog' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'Hackiit Hero Image' }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white highlight text-7xl md:text-8xl">Hackiit</span>
    </Fragment>

    <Fragment slot="subtitle">
      El <span class="font-semibold">Club de Hacking de la Universidad de Granada (UGR)</span>. <br />
      Un espacio dedicado a aprender sobre ciberseguridad, participar en competiciones CTF, investigar y compartir conocimiento entre estudiantes.
    </Fragment>
  </Hero>


  <BlogLatestPosts
    id="blog"
    title="Últimos artículos y Writeups"
    information={`Descubre los últimos posts de nuestro blog. Aquí publicamos resoluciones de retos (CTFs), tutoriales de ciberseguridad y noticias del club.`}
  />


<section class="py-12 sm:py-16 lg:py-20 mx-auto max-w-7xl px-4 sm:px-6">
    <div class="mb-10 text-center">
      <h2 class="tnuevaEmpresaext-2xl font-bold tracking-tight sm:text-3xl mb-2 dark:text-white">Con la colaboración de</h2>
    </div>
    
    <div class="flex flex-wrap justify-center gap-10 md:gap-16 items-center mt-8">
      <a href="https://www.ugr.es" target="_blank" rel="noopener">
        <Image 
          src={ugrLogo} 
          alt="Universidad dejLogo}  Granada" 
          class="h-16 md:h-20 w-auto object-contain hover:scale-105 transition duration-300 bg-white p-2 rounded-lg shadow-sm" 
        />
      </a>
      
      <a href="https://etsiit.ugr.es" target="_blank" rel="noopener">
        <Image 
          src={etsiitLogo} 
          alt="ETSIIT" 
          class="h-16 md:h-20 w-auto object-contain hover:scale-105 transition duration-300 bg-white p-2 rounded-lg shadow-sm" 
        />
      </a>

      <a href="https://jtsec.es" target="_blank" rel="noopener">
        <Image 
          src={jtsecLogo} 
          alt="J" 
          class="h-16 md:h-20 w-auto object-contain hover:scale-105 transition duration-300 bg-white p-2 rounded-lg shadow-sm" 
        />
      </a>

      <a href="https://www.trevenque.es" target="_blank" rel="noopener">
        <Image 
          src={trevenqueLogo} 
          alt="Grupo Trevenque" 
          class="h-16 md:h-20 w-auto object-contain hover:scale-105 transition duration-300 bg-white p-2 rounded-lg shadow-sm" 
        />
      </a>
    </div>
  </section>

</Layout>